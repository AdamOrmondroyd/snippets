{
    "python gitignore": {
        "prefix": ["python"],
        "body": [
            "# Byte-compiled / optimized / DLL files",
            "__pycache__/",
            "*.py[codz]",
            "",
            "# C extensions",
            "*.so",
            "",
            "# Distribution / packaging",
            "build/",
            "dist/",
            "wheels/",
            "*.egg-info",
            ".eggs/",
            "",
            "# setuptools_scm",
            "**/_version.py",
            "",
            "# Environments",
            ".venv",
            "venv/",
            "env/",
            ".env",
            "",
            "# Unit test / coverage reports",
            ".coverage",
            ".coverage.*",
            "coverage.xml",
            "htmlcov/",
            ".pytest_cache/",
            ".ruff_cache/",
            "",
            "# Jupyter Notebook",
            ".ipynb_checkpoints",
            "",
            "# Sphinx documentation",
            "docs/_build/",
            "$0"
        ],
        "description": "Baseline Python .gitignore, curated from github/gitignore Python.gitignore."
    }
}
